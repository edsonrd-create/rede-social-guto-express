# Inject these values through a secret manager. Never commit real tokens.
DATABASE_PATH=/data/guto-social.sqlite3
LIVE_PUBLISH=false
MEDIA_ALLOWED_HOSTS=
META_ACCESS_TOKEN=
META_GRAPH_VERSION=
INSTAGRAM_ACCOUNT_ID=
# Default transport is stdio. streamable-http binds only 127.0.0.1:8765.
MCP_TRANSPORT=stdio

ASSETS_ROOT=/data/reviewed-assets
ARTIFACTS_ROOT=/data/generated-posts

# Required for authenticated remote deployment (no trailing slash in PUBLIC_BASE_URL).
REMOTE_MODE=false
PUBLIC_BASE_URL=
TOKEN_ENCRYPTION_KEY=
OWNER_PASSWORD_HASH=
MCP_ALLOWED_REDIRECT_URIS=
META_APP_ID=
META_APP_SECRET=
